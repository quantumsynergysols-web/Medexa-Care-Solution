# Copy to .env.production (server) or .env.local (development). Never commit the real file.

# Public base URL of the site (canonical URLs, sitemap, Open Graph). Read at build time.
NEXT_PUBLIC_SITE_URL=https://medexacaresolutions.com

# ---- Lead emails (Hostinger mailbox) ----
# Leave SMTP_HOST empty to disable email.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@medexacaresolutions.com
SMTP_PASS=
# Sender shown on emails (must be the SMTP mailbox or an alias of it)
LEAD_FROM="Medexa Care Solutions <info@medexacaresolutions.com>"
# Who receives the new-lead alert (comma-separate several addresses)
LEAD_NOTIFY_TO=info@medexacaresolutions.com

# ---- Optional ----
# POST each new lead here as JSON (works with a Slack incoming webhook)
LEAD_WEBHOOK_URL=
# Where leads are appended as JSON Lines. Default: <app>/.data/leads.jsonl
LEADS_FILE=
